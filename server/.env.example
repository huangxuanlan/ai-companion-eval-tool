# 复制为 server/.env 后填写你自己的密钥。不要把真实密钥提交或打包分发。

# 模型 API Key
VOLCENGINE_API_KEY=
ARK_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
MINIMAX_HER_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
SCORING_API_KEY=
LONGFORM_LOCAL_GEMMA_API_KEY=local-placeholder
LONGFORM_LOCAL_GEMMA_BASE_URL=http://115.190.27.75:19006/v1

# 可选：运行时目录覆盖
# LONGFORM_CONTENT_ROOT=
# LONGFORM_PROVIDER_LLM_DIR=
# LONGFORM_SCORING_PIPELINE_DIR=
# LONGFORM_PIPELINE_SCRIPTS_DIR=

# 可选：端口覆盖
# LONGFORM_HOST=127.0.0.1
# LONGFORM_PORT=8000

# 可选：后端并发（批量队列）上限
# LONGFORM_MAX_CONCURRENT_CONVERSATIONS=10

# 可选：自动打分线程池并发
# SCORING_MAX_WORKERS=6

# 可选：自动打分请求超时（秒）
# SCORING_REQUEST_TIMEOUT_S=120

# 可选：31B 打分超时后的降级模型（留空表示禁用降级）
# SCORING_TIMEOUT_FALLBACK_MODEL_ID=gemma4-26b
